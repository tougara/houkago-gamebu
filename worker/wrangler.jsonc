{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "houkago-online-api",
  "main": "src/index.js",
  "compatibility_date": "2026-10-12",
  "workers_dev": true,
  "durable_objects": {"bindings":[{"name":"ROOMS","class_name":"OnlineRoom"}]},
  "migrations":[{"tag":"v1","new_sqlite_classes":["OnlineRoom"]}],
  "vars":{"ALLOWED_ORIGIN":"https://houkago-gamebu.pages.dev"}
}